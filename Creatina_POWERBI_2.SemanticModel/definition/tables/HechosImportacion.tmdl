table HechosImportacion
	lineageTag: 120a9104-54d1-41fd-a803-87b5e1448acf

	measure 'CIF USD' = SUM(HechosImportacion[US$ CIF])
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: 5126b300-3065-41bd-b5d1-3494fccdf7f3

	measure 'FOB USD' = SUM(HechosImportacion[US$ FOB])
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: d20d2741-118f-4b4c-8df7-501ca0cd916c

	measure 'Logistica USD' = SUM(HechosImportacion[CostoLogistico])
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: 3fef59fc-d65a-40c3-a37f-39422835165a

	measure 'Peso neto kg' = SUM(HechosImportacion[PESO NETO])
		formatString: #,0.00 "kg"
		displayFolder: Indicadores
		lineageTag: 22cdab09-cefc-4fbf-b27f-da756c47a9a4

	measure 'CIF por kg' = DIVIDE([CIF USD], [Peso neto kg])
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: ff5ab276-f7ae-45d2-993b-bbaf28645260

	measure Operaciones = DISTINCTCOUNT(HechosImportacion[Operacion])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 70cb3748-ea3b-4e7c-bfb0-5074aade03ae

	measure Registros = COUNTROWS(HechosImportacion)
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 0269d092-0f0c-4a5b-a526-5846151d1f50

	measure Importadores = DISTINCTCOUNT(HechosImportacion[RUC IMPORTADOR])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: c2130451-4d4f-46af-9480-e37b656ee579

	measure Origenes = DISTINCTCOUNT(HechosImportacion[PAÍS DE ORIGEN])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 1f3fbfed-c5e0-477c-a945-8888aa7ef14a

	measure 'Carga logistica %' = DIVIDE([Logistica USD], [FOB USD])
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 4089c62d-cf94-46e7-ab22-ef0487040c7f

	measure 'Participacion importador %' = DIVIDE([CIF USD], CALCULATE([CIF USD], ALLSELECTED(DimImportador)))
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 6f74c046-fe92-48d6-a538-03417e053a1b

	measure 'CIF año anterior' = CALCULATE([CIF USD], DATEADD(DimFecha[Fecha], -1, YEAR))
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: 1e6affde-0c67-42cf-8306-0c1417f97fe1

	measure 'Variacion interanual %' = VAR Anterior = [CIF año anterior] RETURN IF(NOT ISBLANK(Anterior), DIVIDE([CIF USD]-Anterior, Anterior))
		formatString: 0.00%
		displayFolder: Indicadores
		lineageTag: 9ebf5ecc-5f8c-4021-b213-2c13463c8f79

	measure 'CIF acumulado anual' = TOTALYTD([CIF USD], DimFecha[Fecha])
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: f1e63662-5b4e-439c-b0be-a2264a4c23a7

	measure 'CIF llegada USD' = CALCULATE([CIF USD], USERELATIONSHIP(HechosImportacion[FechaLlegada], DimFecha[Fecha]))
		formatString: "US$" #,0.00
		displayFolder: Indicadores
		lineageTag: ea94e50c-c179-4c0e-9886-e3507fd92571

	measure 'Marcas faltantes' = SUM(HechosImportacion[MarcaFaltante])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 86629386-5b72-444b-a1a7-5641ce416a7d

	measure 'Productos faltantes' = SUM(HechosImportacion[ProductoFaltante])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: aece2576-d35f-48b2-afbe-d7a41c1bd884

	measure 'Atipicos CIF' = SUM(HechosImportacion[AtipicoCIF])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 1b9721f4-be4f-460c-8cd1-e671c980614f

	measure 'Registros marca completa %' = 1-DIVIDE([Marcas faltantes],[Registros])
		formatString: 0.0%
		displayFolder: Indicadores
		lineageTag: 05109737-287b-4cbb-a84e-04990aa73d5c

	measure 'Alertas conciliacion CIF' = COUNTROWS(FILTER(HechosImportacion,ABS(HechosImportacion[DiferenciaCIF])>0.02))
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 4fdb94c3-8a34-460b-8657-88454992244e

	measure 'Duplicados de clave' = [Registros]-DISTINCTCOUNT(HechosImportacion[Linea])
		formatString: 0
		displayFolder: Indicadores
		lineageTag: 3ccb0076-1bdc-4d00-b75d-8922d622be1e

	measure 'Unidades comerciales' = IF(HASONEVALUE(DimProducto[UNIDAD COMERCIAL]),SUM(HechosImportacion[CANTIDAD COMERCIAL]),BLANK())
		formatString: #,0
		displayFolder: Indicadores
		lineageTag: 2f616694-6b44-48ff-bb2f-3d6cb223229d

	measure 'Transito medio por operacion' = AVERAGEX(VALUES(HechosImportacion[Operacion]),CALCULATE(MAX(HechosImportacion[DiasTransito])))
		formatString: 0.0 "días"
		displayFolder: Indicadores
		lineageTag: 2a52268f-2484-4910-8d62-f2592a04daf9


expression RutaExcel = "" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=false]
	lineageTag: 684d7e7e-ac24-41b2-b736-6d28116f9bdb

	annotation PBI_ResultType = Text

expression Staging =
		let
		 Origen = if RutaExcel = "" then Table.FromRecords(Json.Document(Binary.FromText("", BinaryEncoding.Base64))) else Table.PromoteHeaders(Excel.Workbook(File.Contents(RutaExcel), null, true){[Item="Datasur",Kind="Sheet"]}[Data], [PromoteAllScalars=true]),
		 Texto = Table.TransformColumns(Origen, List.Transform({"DUA","SERIE","RUC IMPORTADOR","PARTIDA ARANCELARIA","IMPORTADOR","PAÍS DE ORIGEN","PRODUCTO","MARCA","UNIDAD COMERCIAL","ADUANA","MERCANCÍA"}, (c)=> {c, each if _ = null then null else Text.Upper(Text.Trim(Text.Clean(Text.From(_)))), type text})),
		 Tipos = Table.TransformColumnTypes(Texto, {{"DÍA",Int64.Type},{"MES",Int64.Type},{"AÑO",Int64.Type},{"US$ FOB",type number},{"US$ FLETE",type number},{"US$ SEGURO",type number},{"US$ CIF",type number},{"PESO NETO",type number},{"PESO BRUTO",type number},{"CANTIDAD COMERCIAL",type number},{"IGV",type number},{"IPM",type number},{"ADVALOREM",type number}}, "en-US"),
		 Fecha = Table.AddColumn(Tipos,"Fecha",each #date([AÑO],[MES],[DÍA]),type date),
		 Llegada = Table.AddColumn(Fecha,"FechaLlegada",each try Date.From([#"FECHA DE LLEGADA"]) otherwise null,type date),
		 Embarque = Table.AddColumn(Llegada,"FechaEmbarque",each try Date.From([#"FECHA DE EMBARQUE"]) otherwise null,type date),
		 Operacion = Table.AddColumn(Embarque,"Operacion",each Text.Combine({Text.From([AÑO]),[ADUANA],[DUA]},"|"),type text),
		 Linea = Table.AddColumn(Operacion,"Linea",each [Operacion]&"|"&[SERIE],type text),
		 Producto = Table.AddColumn(Linea,"ProductoInforme",each if [PRODUCTO]=null or [PRODUCTO]="" then "CREATINA (SIN CLASIFICAR)" else [PRODUCTO],type text),
		 Marca = Table.AddColumn(Producto,"MarcaInforme",each if [MARCA]=null or [MARCA]="" then "NO INFORMADA" else if List.Contains({"S/M","SIN MARCA"},[MARCA]) then "SIN MARCA DECLARADA" else [MARCA],type text),
		 ProductoKey = Table.AddColumn(Marca,"ProductoKey",each Text.Combine({[ProductoInforme],[MarcaInforme],[#"UNIDAD COMERCIAL"]},"|"),type text),
		 Delta = Table.AddColumn(ProductoKey,"DiferenciaCIF",each Number.Round([#"US$ CIF"]-[#"US$ FOB"]-[#"US$ FLETE"]-[#"US$ SEGURO"],4),type number),
		 Logistica = Table.AddColumn(Delta,"CostoLogistico",each [#"US$ FLETE"]+[#"US$ SEGURO"],type number),
		 Transito = Table.AddColumn(Logistica,"DiasTransito",each if [FechaLlegada]=null or [FechaEmbarque]=null then null else Duration.Days([FechaLlegada]-[FechaEmbarque]),Int64.Type),
		 MarcaNula = Table.AddColumn(Transito,"MarcaFaltante",each if [MARCA]=null or [MARCA]="" then 1 else 0,Int64.Type),
		 ProductoNulo = Table.AddColumn(MarcaNula,"ProductoFaltante",each if [PRODUCTO]=null or [PRODUCTO]="" then 1 else 0,Int64.Type),
		 Valores = List.Sort(List.RemoveNulls(ProductoNulo[#"US$ CIF"])), Q1=List.Percentile(Valores,0.25), Q3=List.Percentile(Valores,0.75),
		 Atipico = Table.AddColumn(ProductoNulo,"AtipicoCIF",each if [#"US$ CIF"] < Q1-1.5*(Q3-Q1) or [#"US$ CIF"] > Q3+1.5*(Q3-Q1) then 1 else 0,Int64.Type)
		in Atipico
	lineageTag: 7a26c133-42b8-423c-9be8-ff3dfea9eddf

